# Copy this file to `.env` and adjust values.
#
# Vite only exposes variables prefixed with VITE_ to the frontend, and it does
# so by *inlining them into the JavaScript bundle* that ships to the browser.
# Nothing secret can live here — no database URLs, no API keys, no passwords.
# Those belong in the Django backend's own Railway variables.

# Base URL of the Django REST backend, including the /api prefix.
#
# Leave this as /api for local development: vite.config.ts proxies /api to
# VITE_DEV_PROXY_TARGET below, which keeps the browser on one origin so CORS
# never applies. Production builds read `.env.production` instead, which points
# at the deployed API root:
#   VITE_API_BASE_URL=https://backend-production-9f759.up.railway.app/api
VITE_API_BASE_URL=/api

# Where `npm run dev` forwards /api requests. Defaults to the local Django dev
# server; set it to the Railway URL (no /api suffix — the proxied path already
# carries it) to develop against the deployed backend.
VITE_DEV_PROXY_TARGET=http://localhost:8000
