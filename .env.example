# Copy this file to `.env` and adjust values.
# Vite only exposes variables prefixed with VITE_ to the frontend.

# Base URL of the backend REST API (Member 2's server).
# In dev, leaving this as /api uses the proxy configured in vite.config.ts.
# In production, set the full URL, e.g. https://your-backend.example.com/api
VITE_API_BASE_URL=/api

# Mock mode: when "true", the app uses in-memory fake data so the UI
# runs WITHOUT a backend. Set to "false" once the real API is ready.
VITE_USE_MOCK=true
